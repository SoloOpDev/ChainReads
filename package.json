{
  "name": "chainreads-cloudflare",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler pages dev dist/public --compatibility-date=2024-01-01 --d1=DB --kv=KV --r2=R2",
    "build": "npx update-browserslist-db@latest && npx vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "start": "node dist/server/index.js",
    "deploy": "wrangler pages deploy dist/public",
    "d1:create": "wrangler d1 create chainreads-db",
    "d1:migrate": "wrangler d1 migrations apply chainreads-db --local",
    "d1:migrate:prod": "wrangler d1 migrations apply chainreads-db",
    "d1:studio": "drizzle-kit studio --config=drizzle.config.d1.ts",
    "d1:generate": "drizzle-kit generate --config=drizzle.config.d1.ts",
    "kv:create": "wrangler kv:namespace create KV",
    "r2:create": "wrangler r2 bucket create chainreads-images",
    "check": "tsc"
  },
  "dependencies": {
